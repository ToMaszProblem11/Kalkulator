clear;
close all;
clc;

fs=100; % częstotliwość próbkowania wyrażona w Hz
T=1/fs; % okres próbkowania

t=0:T:1-T; % wektor czasu od 0 do 1 z krokiem T
y=1*sin(2*pi*1*t); % 1 po pi to częstotliwość
figure; %otwiera okno graficzne
plot(y,'o') % -o łączy punkty

xlabel('Numer próbki [N]') 
ylabel('Amplituda [V]')

figure; %otwiera okno graficzne
plot(t,y,'o')
xlabel('Czas [s]') 
ylabel('Amplituda [V]')

grid on
axis tight

