clear;
close all;
clc;

fs=200; 
T=1/fs; 

t=0:T:1-T; 
y1=1*sin(2*pi*7*t)+1;
y2=1*sin(2*pi*17*t+pi/3)-3;

X=y1+y2+rand(1,200);
figure;
plot(y1,'-ob')
hold on; %kilka wykresów w jednym oknie
plot(y2,'-or')
plot(X,'-og')
plot(rand)

legend('suma','y1','y2','X')






