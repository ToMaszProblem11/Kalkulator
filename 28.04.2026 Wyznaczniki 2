
#include <stdio.h>

void odwroc(char txt[])
{
	char *poczatek = txt;
	char *koniec = txt;
	char znaczek;
	while (*(koniec+1)!=0) koniec++; //sprawdza czy następny znak to znak null \0, którego wartość to 0, jeśli nie to przesuwa się w prawo i zatrzymuje się przed znakiem null.

    while(poczatek < koniec)
	{
		znaczek = *poczatek; //przypisujemy 1 znak do pamięci "znaczek"
		*poczatek = *koniec; //na początek przypisujemy ostatni znak na wskaźniku koniec
		*poczatek++;         //przesuwamy się na następny znak
		*koniec = znaczek;   //na koniec przypisujemy pierwszy znak, który zapisaliśmy w                     pamięci
		*koniec--;           // cofamy się o jeden znak
	}
	//pętla jest wykonywana dopóki początek i koniec nie znajdą się pod tym samym znakiem
}
int main()
{
	char txt[] = "1234";
	printf("rozmiar tablicy: %d\n", (int)(sizeof(txt) / sizeof(char)));
	printf("\n");
	printf("odwrocony tekst to:");
	odwroc(txt);
	for(int i=0; i<4; i++) 	printf("%c", txt[i]);
	return 0;
}



