#include <stdio.h>
int transponuj(int *macierz, int l_wierszy, int l_kolumn)
{
	int para2index(int wiersz, int kolumna, int l_kolumn)
	{
		return wiersz * l_kolumn + kolumna;
	}
	int index2wiersz(int index, int l_kolumn)
	{
		return index / l_kolumn;
	}
	int index2kolumna(int index, int l_kolumn)
	{
		return index % l_kolumn;
	}
	
	 for (int i = 0; i < l_wierszy; i++) 
	 {
        for (int j = i + 1; j < l_kolumn; j++) 
        {
            int pamiec = *(macierz + i * l_kolumn + j);
            *(macierz + i * l_kolumn + j) = *(macierz + j * l_kolumn + i);
            *(macierz + j * l_kolumn + i) = pamiec;
            
        }
    }
    return 0;
}

void wypisz(int* macierz, int l_wierszy, int l_kolumn)
{
     for (int i = 0; i < l_wierszy; i++) {
        for (int j = 0; j < l_kolumn; j++) {
            // Skoro w tej funkcji nie ma wklejonego "para2index", liczymy to ręcznie tak jak robi to ta funkcja:
            printf("%d ", *(macierz + i * l_kolumn + j));
        }
        printf("\n");
    }
    printf("\n");

}

int main()
{
	int macierz[2][2] = { {1,2},{3,4} };

	int para2index(int wiersz, int kolumna, int l_kolumn)
	{
		return wiersz * l_kolumn + kolumna;
	}

	int index2wiersz(int index, int l_kolumn)
	{
		return index / l_kolumn;
	}

	int index2kolumna(int index, int l_kolumn)
	{
		return index % l_kolumn;
	}

	printf("%d\n", para2index(1, 1, 2));
	 printf("Macierz oryginalna:\n");
    wypisz((int*)macierz, 2, 2); // (int*) jest potrzebne, by z 2D zrobic 1D

    transponuj((int*)macierz, 2, 2);

    printf("Macierz po transpozycji:\n");
    wypisz((int*)macierz, 2, 2);

    return 0;
}

//wypisz
//transponuj 2x6 -> 6x2
//wypisz
