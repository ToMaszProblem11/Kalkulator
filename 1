fs = 16000;
T_total = 4.0;
t = 0:1/fs:T_total;
y = zeros(size(t));

%% --- T (0.2 - 0.7 s) ---
% Belka pozioma (3500 Hz):
idx_T_top = (t >= 0.2 & t < 0.7);
y(idx_T_top) = y(idx_T_top) + 0.5 * sin(2*pi*3500*t(idx_T_top));

% Belka pionowa w środku (0.43 - 0.47 s):
idx_T_stem = (t >= 0.43 & t < 0.47);
t_stem = t(idx_T_stem);
for f = 1200:150:3500
    y(idx_T_stem) = y(idx_T_stem) + 0.12 * sin(2*pi*f*t_stem);
end

%% --- o (0.8 - 1.3 s) ---
idx_o = (t >= 0.8 & t < 1.3);
t_o = t(idx_o);
tau = linspace(-1, 1, length(t_o));
f_mid = 2300; R_f = 900;
% Dwa półokręgi (górny i dolny profil częstotliwości):
f_top = f_mid + R_f * sqrt(max(0, 1 - tau.^2));
f_bot = f_mid - R_f * sqrt(max(0, 1 - tau.^2));
phi_top = 2 * pi * cumsum(f_top) / fs;
phi_bot = 2 * pi * cumsum(f_bot) / fs;
y(idx_o) = y(idx_o) + 0.3 * sin(phi_top) + 0.3 * sin(phi_bot);

%% --- M (1.4 - 2.1 s) ---
% Składa się z 4 odcinków (dwie pionowe i dwie skośne):
% 1) Wzrost: 1200 -> 3500 Hz
t_m1 = (t >= 1.4 & t < 1.57);
y(t_m1) = y(t_m1) + 0.4 * chirp(t(t_m1), 1200, max(t(t_m1)), 3500);
% 2) Spadek: 3500 -> 2200 Hz
t_m2 = (t >= 1.57 & t < 1.75);
y(t_m2) = y(t_m2) + 0.4 * chirp(t(t_m2), 3500, max(t(t_m2)), 2200);
% 3) Wzrost: 2200 -> 3500 Hz
t_m3 = (t >= 1.75 & t < 1.93);
y(t_m3) = y(t_m3) + 0.4 * chirp(t(t_m3), 2200, max(t(t_m3)), 3500);
% 4) Spadek: 3500 -> 1200 Hz
t_m4 = (t >= 1.93 & t < 2.1);
y(t_m4) = y(t_m4) + 0.4 * chirp(t(t_m4), 3500, max(t(t_m4)), 1200);

%% --- a (2.2 - 2.6 s) ---
% Brzuch 'a' (owal) + pionowa laseczka po prawej:
idx_a = (t >= 2.2 & t < 2.5);
tau_a = linspace(-1, 1, sum(idx_a));
fa_top = 2000 + 600 * sqrt(max(0, 1 - tau_a.^2));
fa_bot = 2000 - 600 * sqrt(max(0, 1 - tau_a.^2));
y(idx_a) = y(idx_a) + 0.25 * sin(2*pi*cumsum(fa_top)/fs) + 0.25 * sin(2*pi*cumsum(fa_bot)/fs);
% Pionowa kreska po prawej (2.48 - 2.52 s):
idx_a_stem = (t >= 2.48 & t < 2.52);
for f = 1400:150:2600
    y(idx_a_stem) = y(idx_a_stem) + 0.12 * sin(2*pi*f*t(idx_a_stem));
end

%% --- s (2.7 - 3.1 s) ---
% Trzy poziome kreski połączone dwoma pionowymi/skosami:
idx_s1 = (t >= 2.7 & t < 3.1);
y(idx_s1) = y(idx_s1) + 0.25 * sin(2*pi*2700*t(idx_s1)); % góra
y(idx_s1) = y(idx_s1) + 0.25 * sin(2*pi*2000*t(idx_s1)); % środek
y(idx_s1) = y(idx_s1) + 0.25 * sin(2*pi*1300*t(idx_s1)); % dół
idx_s_left = (t >= 2.7 & t < 2.75); % lewa pionowa środek-dół
for f = 1300:150:2000
    y(idx_s_left) = y(idx_s_left) + 0.1 * sin(2*pi*f*t(idx_s_left));
end
idx_s_right = (t >= 3.05 & t < 3.1); % prawa pionowa góra-środek
for f = 2000:150:2700
    y(idx_s_right) = y(idx_s_right) + 0.1 * sin(2*pi*f*t(idx_s_right));
end

%% --- z (3.2 - 3.6 s) ---
% Góra (2700 Hz), dół (1300 Hz) i ukośna belka:
idx_z = (t >= 3.2 & t < 3.6);
y(idx_z) = y(idx_z) + 0.3 * sin(2*pi*2700*t(idx_z));
y(idx_z) = y(idx_z) + 0.3 * sin(2*pi*1300*t(idx_z));
% Skos od góry do dołu:
y(idx_z) = y(idx_z) + 0.35 * chirp(t(idx_z), 2700, max(t(idx_z)), 1300);

%% Normalizacja i wykres
y = y / max(abs(y));
figure;
spectrogram(y, kaiser(256, 5), 220, 512, fs, 'yaxis');
colormap(jet);
title('Spektrogram z czytelnym napisem ToMasz');
